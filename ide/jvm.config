# This file defines the JVM parameters used to run Portugol Studio
#
# If you are using Eclipse, refresh the gradle project after changing this file or
# the changes will not take effect
#
# - Blank lines are allowed between parameters
# 
# - Use "#" or "//" to comment lines
#
# - Use the symbol "->" after the parameter to specifiy a list o operating systems where the
#   parameter will be applied. Valid values are: windows, linux and osx. Ex: 
#
#     -Xms64m -> windows
#     -Xms128m -> linux, osx
#         
# 
-Dvisualvm.display.name=Portugol-Studio
-Xms64m
-Xmx768m
-Xdock:name=Portugol-Studio -> osx
-Dapple.awt.application.appearance=system -> osx

# WebLaF 1.29 embeds an old XStream release that needs reflective access on
# strongly encapsulated JDKs. Keep these scoped to the packages it serializes.
--add-opens=java.base/java.util=ALL-UNNAMED
--add-opens=java.base/java.lang.reflect=ALL-UNNAMED
--add-opens=java.base/java.text=ALL-UNNAMED
--add-opens=java.desktop/java.awt=ALL-UNNAMED
--add-opens=java.desktop/java.awt.font=ALL-UNNAMED
--add-opens=java.desktop/javax.swing=ALL-UNNAMED
--add-opens=java.desktop/javax.swing.table=ALL-UNNAMED
--add-opens=java.desktop/javax.swing.tree=ALL-UNNAMED
